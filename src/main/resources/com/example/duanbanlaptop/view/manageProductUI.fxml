<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.duanbanlaptop.admin.PutDataIntoTableView">
    <VBox minHeight="360" minWidth="799" spacing="30">

        <TableView fx:id="tableView" minHeight="350" minWidth="799">
            <columns>
                <TableColumn fx:id="columnId" minWidth="80" text="idProduct" />
                <TableColumn fx:id="columnName" minWidth="150" text="nameProduct" />
                <TableColumn fx:id="columnDescribe" minWidth="210" text="describe" />
                <TableColumn fx:id="columnUnit" minWidth="80" text="unit" />
                <TableColumn fx:id="columnImage" minWidth="114" text="image" />
                <TableColumn fx:id="columnPrice" minWidth="80" text="price" />
                <TableColumn fx:id="columnStock" minWidth="84" text="stock" />
            </columns>
        </TableView>
    </VBox>
    <HBox alignment="CENTER" layoutX="156.0" layoutY="398.0" prefHeight="106.0" prefWidth="644.0" spacing="70">
        <Button minWidth="90" onAction="#addProduct" style="-fx-background-color: #33CC00; -fx-font-size: 13; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0.5, 0, 2) " text="Add" />
        <Button minWidth="90" onAction="#edit" style="-fx-background-color: #FFCC00; -fx-font-size: 13; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0.5, 0, 2)" text="Edit" />
        <Button minWidth="90" onAction="#delete" style="-fx-background-color: #CC0000; -fx-font-size: 13; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 10, 0.5, 0, 2)" text="Delete" />
      <AnchorPane prefHeight="200.0" prefWidth="200.0" />
    </HBox>
    </AnchorPane>
