<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.duanbanlaptop.user.CartController"
            prefHeight="600.0" prefWidth="1000.0">

    <center>
        <VBox spacing="30">
            <TableView fx:id="tableView" minHeight="350" minWidth="799">
                <columns>
                    <TableColumn fx:id="columnNameCart" minWidth="180" text="Name Product" />
                    <TableColumn fx:id="columnImageCart" minWidth="184" text="Image" />
                    <TableColumn fx:id="columnDescribeCart" minWidth="210" text="Describe" />
                    <TableColumn fx:id="columnPriceCart" minWidth="130" text="Price" />
                    <TableColumn fx:id="columnQuantityCart" minWidth="150" text="Quantity" />
                    <TableColumn fx:id="columnOderDate" minWidth="150" text="OderDate" />
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="90">
                <HBox spacing="15" minWidth="300">
                    <Label text="Total : " style="-fx-font-size: 20; -fx-font-weight: bold"/>
                    <Label text="5000$" style="-fx-font-size: 17"/>
                </HBox>
                <VBox spacing="25" minWidth="300">
                    <Button text="Order" minWidth="300" style="-fx-font-size: 20; -fx-background-color: #FF9966; -fx-background-size: 300"/>
                    <Button onMouseClicked="#backHome" text="Come Back" minWidth="300" style="-fx-font-size: 20; -fx-background-color: #00CCCC"/>
                </VBox>


            </HBox>
        </VBox>

    </center>

</BorderPane>
