<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.duanbanlaptop.admin.AdminInformationController"
            prefHeight="400.0" prefWidth="600.0">

    <center>
        <VBox alignment="CENTER"  style="-fx-background-color:#CAE1FF ">
            <Label text="INFORMATION" style="-fx-font-size: 25; -fx-font-weight: bold"/>
            <VBox alignment="CENTER" spacing="30" maxWidth="400" minHeight="300" style="-fx-border-color: red; -fx-background-color: #00FA9A">
                <HBox alignment="CENTER" spacing="25">
                    <Label text="User name :" style=" -fx-font-size: 15" minWidth="120" alignment="CENTER_RIGHT"/>
                    <Label fx:id="nameCustomer" text="" minWidth="170" style="-fx-font-size: 15"/>
                </HBox>
                <HBox alignment="CENTER" spacing="25">
                    <Label text="Number phone :" minWidth="120" style=" -fx-font-size: 15" alignment="CENTER_RIGHT"/>
                    <Label fx:id="numberCustomer" text=""  minWidth="170" style=" -fx-font-size: 15"/>
                </HBox>
                <HBox alignment="CENTER" spacing="25">
                    <Label text="Adress :" minWidth="120" style=" -fx-font-size: 15" alignment="CENTER_RIGHT"/>
                    <Label fx:id="addressCustomer" text=""  minWidth="170" style=" -fx-font-size: 15"/>
                </HBox>
                <HBox alignment="CENTER" spacing="25">
                    <Label text="Email :" minWidth="120" style=" -fx-font-size: 15" alignment="CENTER_RIGHT"/>
                    <Label fx:id="emailCustomer" text=""  minWidth="170" style=" -fx-font-size: 15"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
